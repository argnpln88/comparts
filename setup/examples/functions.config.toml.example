# Merge into the config generated by supabase init.
# Payment implementations are now in supabase/functions. The generated project
# config already has their settings; this remains an architecture reference.
# Every user-facing handler must validate the user and check authorization.
[functions.checkout-quote]
verify_jwt = true

[functions.checkout-create]
verify_jwt = true

[functions.checkout-status]
verify_jwt = true

[functions.commerce-order]
verify_jwt = true

# Xendit supplies no Supabase user JWT. Handler MUST verify x-callback-token.
[functions.xendit-webhook]
verify_jwt = false

# Handler MUST reject callers without the configured scheduler credential.
[functions.payment-reconcile]
verify_jwt = false

[functions.order-cancel]
verify_jwt = true

[functions.order-transition]
verify_jwt = true

[functions.refund-create]
verify_jwt = true

[functions.seller-admin]
verify_jwt = true
