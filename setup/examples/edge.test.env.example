# Proposed application configuration. Backend functions must read these names.
# Copy to an ignored .env.edge.test file, or enter directly in Edge Function Secrets.
# Never copy this file's populated values into Flutter.
XENDIT_SECRET_KEY=YOUR_XENDIT_TEST_SECRET_KEY
XENDIT_CALLBACK_TOKEN=YOUR_XENDIT_WEBHOOK_VERIFICATION_TOKEN
XENDIT_BUSINESS_ID=YOUR_XENDIT_BUSINESS_ID
XENDIT_ENV=test
PAYMENT_RETURN_BASE_URL=https://YOUR_HTTPS_HOST.example
RECONCILIATION_JOB_SECRET=YOUR_SEPARATE_RANDOM_SCHEDULER_SECRET
